From: Stefan <104927860+Steefzar@users.noreply.github.com>
Subject: [PATCH] platform/surface: bind rtc-surface and keep the EC clock
 offset by the firmware's TimeZone, so the boot clock is UTC

On Surface Laptop 3/4 the firmware rebuilds the CMOS RTC at POST from the EC
clock minus the TimeZone it keeps in EDK2 PcRtc's "RTC" EFI variable. No
registry group instantiates ssam:01:01:01:00:00, so rtc-surface never binds
and nothing maintains that clock -- the machine then boots 1h57m fast until
timesyncd corrects it, which is long enough to break a WireGuard handshake.
Register the node for Laptop 3/4 and offset reads and writes by the TimeZone.
Measurements, reasoning and how to regenerate this patch are in STATUS.

diff --git a/drivers/platform/surface/surface_aggregator_registry.c b/drivers/platform/surface/surface_aggregator_registry.c
index e0c07e5..94072b2 100644
--- a/drivers/platform/surface/surface_aggregator_registry.c
+++ b/drivers/platform/surface/surface_aggregator_registry.c
@@ -51,6 +51,12 @@ static const struct software_node ssam_node_hub_base = {
 	.parent = &ssam_node_root,
 };
 
+/* Real-time clock kept by the EC (rtc-surface). */
+static const struct software_node ssam_node_rtc = {
+	.name = "ssam:01:01:01:00:00",
+	.parent = &ssam_node_root,
+};
+
 /* AC adapter. */
 static const struct software_node ssam_node_bat_ac = {
 	.name = "ssam:01:02:01:01:01",
@@ -252,6 +258,7 @@ static const struct software_node *ssam_node_group_sb3[] = {
 /* Devices for Surface Laptop 3 and 4. */
 static const struct software_node *ssam_node_group_sl3[] = {
 	&ssam_node_root,
+	&ssam_node_rtc,
 	&ssam_node_bat_ac,
 	&ssam_node_bat_main,
 	&ssam_node_tmp_perf_profile,
diff --git a/drivers/rtc/rtc-surface.c b/drivers/rtc/rtc-surface.c
index f6c17c4..3462d52 100644
--- a/drivers/rtc/rtc-surface.c
+++ b/drivers/rtc/rtc-surface.c
@@ -6,10 +6,12 @@
  * Copyright (C) 2019-2021 Maximilian Luz <luzmaximilian@gmail.com>
  */
 
+#include <linux/efi.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/rtc.h>
 #include <linux/slab.h>
+#include <linux/timekeeping.h>
 #include <linux/types.h>
 
 #include <linux/surface_aggregator/device.h>
@@ -17,8 +19,43 @@
 struct surface_rtc {
 	struct ssam_device *sdev;
 	struct rtc_device *rtc;
+	s32 fw_offset;	/* seconds the EC must run ahead of UTC, see below */
 };
 
+/*
+ * At POST the firmware sets the CMOS RTC to the EC clock minus the TimeZone it
+ * keeps in EDK2 PcRtc's "RTC" variable (minutes, low 16 bits; 480 on a Surface
+ * Laptop 4 AMD, measured to the second). Linux keeps the CMOS RTC on UTC, so
+ * the EC has to run that far ahead of UTC for the next boot to come up on UTC.
+ */
+#define SURFACE_RTC_TZ_UNSPEC	2047
+
+static efi_char16_t surface_rtc_tz_name[] = L"RTC";
+static efi_guid_t surface_rtc_tz_guid =
+	EFI_GUID(0x378d7b65, 0x8da9, 0x4773, 0xb6, 0xe4, 0xa4, 0x78, 0x26, 0xa8, 0x33, 0xe1);
+
+static s32 surface_rtc_fw_offset(void)
+{
+	unsigned long size = sizeof(u32);
+	efi_status_t status;
+	u32 attr, val;
+	s16 tz;
+
+	if (!efi_rt_services_supported(EFI_RT_SUPPORTED_GET_VARIABLE))
+		return 0;
+
+	status = efi.get_variable(surface_rtc_tz_name, &surface_rtc_tz_guid,
+				  &attr, &size, &val);
+	if (status != EFI_SUCCESS || size != sizeof(val))
+		return 0;
+
+	tz = (s16)(val & 0xffff);
+	if (tz == SURFACE_RTC_TZ_UNSPEC || tz < -1440 || tz > 1440)
+		return 0;
+
+	return tz * 60;
+}
+
 SSAM_DEFINE_SYNC_REQUEST_R(__ssam_rtc_get_unix_time, __le32, {
 	.target_category = SSAM_SSH_TC_SAM,
 	.target_id       = SSAM_SSH_TID_SAM,
@@ -63,7 +100,7 @@ static int surface_rtc_read_time(struct device *dev, struct rtc_time *tm)
 	if (status)
 		return status;
 
-	rtc_time64_to_tm(time, tm);
+	rtc_time64_to_tm((time64_t)time - srtc->fw_offset, tm);
 	return 0;
 }
 
@@ -72,7 +109,7 @@ static int surface_rtc_set_time(struct device *dev, struct rtc_time *tm)
 	struct surface_rtc *srtc = dev_get_drvdata(dev);
 	time64_t time = rtc_tm_to_time64(tm);
 
-	return ssam_rtc_set_unix_time(srtc, (u32)time);
+	return ssam_rtc_set_unix_time(srtc, (u32)(time + srtc->fw_offset));
 }
 
 static const struct rtc_class_ops surface_rtc_ops = {
@@ -89,6 +126,10 @@ static int surface_rtc_probe(struct ssam_device *sdev)
 		return -ENOMEM;
 
 	srtc->sdev = sdev;
+	srtc->fw_offset = surface_rtc_fw_offset();
+	if (srtc->fw_offset)
+		dev_info(&sdev->dev, "EC clock kept %d min ahead of UTC (firmware TimeZone)\n",
+			 srtc->fw_offset / 60);
 
 	srtc->rtc = devm_rtc_allocate_device(&sdev->dev);
 	if (IS_ERR(srtc->rtc))
@@ -107,6 +148,22 @@ static void surface_rtc_remove(struct ssam_device *sdev)
 	/* Device-managed allocations take care of everything... */
 }
 
+/*
+ * The firmware reloads the CMOS RTC from this EC clock at every boot, and the
+ * NTP 11-minute mode only ever writes the CMOS RTC. Hand the system time to the
+ * EC on the way down so the next boot starts on it rather than on whatever the
+ * EC last held (e.g. local time written by Windows).
+ */
+static void surface_rtc_shutdown(struct device *dev)
+{
+	struct surface_rtc *srtc = dev_get_drvdata(dev);
+	int status;
+
+	status = ssam_rtc_set_unix_time(srtc, (u32)(ktime_get_real_seconds() + srtc->fw_offset));
+	if (status)
+		dev_warn(dev, "failed to write system time to EC: %d\n", status);
+}
+
 static const struct ssam_device_id surface_rtc_match[] = {
 	{ SSAM_SDEV(SAM, SAM, 0x00, 0x00) },
 	{ },
@@ -120,6 +177,7 @@ static struct ssam_device_driver surface_rtc_driver = {
 	.driver = {
 		.name = "surface_rtc",
 		.probe_type = PROBE_PREFER_ASYNCHRONOUS,
+		.shutdown = surface_rtc_shutdown,
 	},
 };
 module_ssam_device_driver(surface_rtc_driver);
